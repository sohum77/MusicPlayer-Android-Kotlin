# ============================================
# 🎵 Music Player – Android (Kotlin)
# Clean .gitignore for Android Studio + Gradle
# ============================================

# --- Gradle ---
.gradle/
build/
**/build/

# --- Local Configuration ---
local.properties
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/shelf/
.idea/gradle.xml
.idea/compiler.xml
.idea/jarRepositories.xml

# --- Android Studio ---
*.iml
.DS_Store
*.log
*.lock
captures/
.externalNativeBuild/
.cxx/
.gradle/
*.hprof

# --- Generated by Gradle or Android Studio ---
.gradle/
app/build/
output.json
*.apk
*.ap_
*.dex
*.class

# --- OS-specific files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# --- Log and cache files ---
*.log
*.tmp
*.swp

# --- Keystore files (if used for signing) ---
*.jks
*.keystore

# --- Environment / Temporary files ---
.env
.vscode/
.idea/
*.orig
*.bak

# --- Gradle Wrapper files (Keep these) ---
!gradlew
!gradlew.bat
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ============================================
# ✅ KEEP THESE FOLDERS (Do NOT Ignore)
# ============================================

# Keep APK folder for demo builds
!APK/
!APK/*.apk

# Keep screenshots for README
!music_player_screenshots/
!music_player_screenshots/*

# Keep documentation
!README.md

# ============================================
# ✅ Summary
# Keeps build, cache, and system files out of GitHub.
# Keeps APK and Screenshots for your project showcase.
# ============================================

